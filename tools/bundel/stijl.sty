% ---------- examens (deel 2) ----------
\newcommand\Examen[7]{% k, jaar, tijdvak, vragen, punten, label, label uitwerkingen
  \clearpage\colorlet{hs}{kleurex}\renewcommand\Tab{\ExamenTab}\renewcommand\Tabtekst{Examen #1}%
  \renewcommand\kopL{Deel 2 \textbullet\ Examen #1}\renewcommand\kopR{\VakNaam\ \textbullet\ #2 tijdvak #3}%
  \thispagestyle{kaal}\phantomsection\label{#6}\pdfbookmark[0]{Examen #1: #2 tijdvak #3}{#6}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[hs] (current page.north west) rectangle ($(current page.north east)+(0,-70mm)$);
    \node[anchor=south west,text=white,align=left] at ($(current page.north west)+(13.5mm,-62mm)$)
      {{\sffamily\halfvet\footnotesize\MakeUppercase{Examen #1}}\\[1mm]
       {\sffamily\zwart\fontsize{26}{30}\selectfont #2}\\[1mm]
       {\sffamily\fontsize{12}{14}\selectfont centraal examen \textbullet\ tijdvak #3}};
  \end{tikzpicture}\par\nointerlineskip
  \vspace*{54mm}%
  {\sffamily\small
  \begin{tabularx}{\linewidth}{@{}>{\bfseries}p{24mm}X@{}}
    Tijd & \ExamenDuur \\[3pt]
    Vragen & #4 vragen, samen #5 punten \\[3pt]
    Hulpmiddelen & \ExamenHulp \\[3pt]
    \FormuleRij
    Uitwerkingen & vanaf blz.~\pageref{#7} \\
  \end{tabularx}}\par\vskip 10mm
  {\opmaakproza\small Maak dit examen in \'e\'en keer, met een wekker op \ExamenDuur, en kijk pas daarna in de uitwerkingen.
  Werk op losse vellen; bij vragen met een uitwerkbijlage teken je in het boek. Schrijf je berekeningen en redeneringen volledig op:
  bij de meeste vragen krijg je ook punten voor de tussenstappen.\par}
  \vfill
  {\sffamily\small\color{grijs}Begintijd \enspace\rule{22mm}{0.4pt}\qquad Eindtijd \enspace\rule{22mm}{0.4pt}}\par
  \clearpage}
\newcommand\ExOpgave[2]{% titel, label

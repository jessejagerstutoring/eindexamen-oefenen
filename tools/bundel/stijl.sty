% ---------- uitsneden uit de originele examens ----------
% Elke pagina van een origineel wordt één keer opgeslagen: \DefPag{naam}{pdf}{pagina}
\newcommand\DefPag[3]{\saveimageresource page #3 {#2}%
  \expandafter\xdef\csname pag@#1\endcsname{\the\lastsavedimageresourceindex}}
% \Blok{witruimte erboven (bp)}{breekstraf}{naam}{links/boven/breedte/hoogte/paginabreedte/paginahoogte}{labels}
% (alle maten al geschaald, in bp)
% geometrie van een uitsnede: x en y in het origineel, breedte en hoogte van het stuk, paginamaat, inspringing
% (afstand van de rand van het stuk tot waar de tekst begint; die tekst komt op de linkermarge)
\def\Bgeo#1/#2/#3/#4/#5/#6/#7\relax{\def\Bdx{#1}\def\Bdy{#2}\def\Bcw{#3}\def\Bch{#4}\def\Bfw{#5}\def\Bfh{#6}\def\Bins{#7}}
\newcommand\BlokTikz[2]{% naam, labels (geometrie staat al in \Bdx enz.)
  \begin{tikzpicture}[x=1bp,y=1bp]
    \coordinate (b) at (0,0);
    \useasboundingbox (0,0) rectangle (\Bcw,-\Bch);
    \begin{scope}
      \clip (0,0) rectangle (\Bcw,-\Bch);
      \node[inner sep=0,outer sep=0,anchor=north west] at (-\Bdx,\Bdy) {\useimageresource width \Bfw bp height \Bfh bp \csname pag@#1\endcsname};
    \end{scope}#2
  \end{tikzpicture}}
\newcommand\Blok[5]{% gat, straf, naam, geometrie, labels
  \par\penalty#2\relax\vskip#1bp\relax\nointerlineskip\Bgeo#4\relax
  \noindent\hspace*{-\Bins bp}\BlokTikz{#3}{#5}\par\nointerlineskip}
% Figuurblok dat zichzelf iets verkleint (tot factor #6) als het net niet meer op de pagina past;
% anders gaat het gewoon naar de volgende pagina en blijft er een gat over.
\newdimen\Brest \newdimen\Bhoog
\newcommand\BlokPas[6]{% gat, straf, naam, geometrie, labels, kleinste factor
  \par\penalty#2\relax\vskip#1bp\relax\nointerlineskip\Bgeo#4\relax
  \Bhoog=\Bch bp\relax
  \ifdim\pagegoal=\maxdimen \Brest=\textheight \else \Brest=\dimexpr\pagegoal-\pagetotal-6pt\relax\fi
  \def\Bfactor{1}%
  \ifdim\Bhoog>\Brest
    \ifdim\dimexpr#6\Bhoog\relax<\Brest
      \pgfmathsetmacro\Bfactor{\Brest/\Bhoog}%
    \fi
  \fi
  \noindent\hspace*{-\Bins bp}\scalebox{\Bfactor}{\BlokTikz{#3}{#5}}\par\nointerlineskip}
\newcommand\Lbl[2]{\node[overlay,anchor=north east,inner sep=0,align=right] at ($(b)+(\Bins bp-2.4mm,-#1bp+0.6bp)$) {#2};}
\newcommand\VraagNr[3]{\label{#3}{\sffamily\bfseries\fontsize{10.5}{11}\selectfont\color{hs}#1}\\[-0.5pt]{\sffamily\fontsize{7}{8}\selectfont\color{grijs}#2p}}
\newcommand\AntwNr[2]{\label{#2}{\sffamily\bfseries\fontsize{10.5}{11}\selectfont\color{hs}#1}}

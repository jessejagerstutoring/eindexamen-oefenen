% ---------- delen, hoofdstukken, onderwerpen, opgaven ----------
\newcommand\Deel[4]{% nummer, titel, tekst, kleur
  \clearpage\thispagestyle{leeg}\colorlet{hs}{#4}\phantomsection\label{deel#1}%
  \pdfbookmark[-1]{#2}{deel#1}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[hs] (current page.south west) rectangle (current page.north east);
    \begin{scope}[opacity=.12,white,line width=.5pt]
      \foreach \i in {0,...,15} {\draw ($(current page.south west)+(0,\i*14mm)$) -- ++(148mm,0);}
      \foreach \i in {0,...,11} {\draw ($(current page.south west)+(\i*14mm,0)$) -- ++(0,210mm);}
    \end{scope}
    \node[anchor=north west,text=white,font=\sffamily\licht\fontsize{90}{90}\selectfont] at ($(current page.north west)+(14mm,-22mm)$) {#1};
    \node[anchor=south west,text=white,align=left,text width=112mm] at ($(current page.south west)+(14mm,30mm)$)
      {{\sffamily\zwart\fontsize{24}{28}\selectfont #2}\\[6mm]{\sffamily\fontsize{10.5}{14}\selectfont #3}};
  \end{tikzpicture}\clearpage}

\newcommand\Hoofdstuk[4]{% nummer, naam, aantal opgaven, onderwerpen
  \clearpage\colorlet{hs}{kleur#1}\renewcommand\Tab{#1}\renewcommand\Tabtekst{#1}%
  \renewcommand\kopL{Deel 1 \textbullet\ #2}%
  \thispagestyle{kaal}\phantomsection\label{hs:#1}\pdfbookmark[0]{#1 #2}{hs#1}%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[hs] (current page.north west) rectangle ($(current page.north east)+(0,-56mm)$);
    \begin{scope}[opacity=.14,white,line width=.5pt]
      \foreach \i in {0,...,4} {\draw ($(current page.north west)+(0,-\i*14mm)$) -- ++(148mm,0);}
      \foreach \i in {0,...,11} {\draw ($(current page.north west)+(\i*14mm,0)$) -- ++(0,-56mm);}
    \end{scope}
    \node[anchor=south west,text=white,align=left] at ($(current page.north west)+(13.5mm,-50mm)$)
      {{\sffamily\halfvet\footnotesize\MakeUppercase{Hoofdstuk #1}}\\[1mm]{\sffamily\zwart\fontsize{19}{22}\selectfont\parbox[b]{118mm}{\raggedright #2}}};
  \end{tikzpicture}\par\nointerlineskip
  \vspace*{37mm}%
  {\sffamily\footnotesize\color{grijs}In dit hoofdstuk: #3 opgaven, ingedeeld naar onderwerp.}\par\vskip 4pt
  {\sffamily\small\begin{tabular*}{\linewidth}{@{}l@{\extracolsep{\fill}}r@{}}#4\end{tabular*}}\par\vskip 6pt}
\newcommand\HsOnderwerp[5]{\textcolor{hs}{\bfseries #2}\enspace #1 {\color{grijs}\scriptsize(#3)}\dotfill & \pageref{#5}\\[1pt]}

\newcommand\Onderwerp[4]{% naam, syllabuscode, omschrijving, label
  \par\Needspace{0.3\textheight}\vskip 14pt
  \phantomsection\label{#4}\pdfbookmark[1]{#1}{bm-#4}%
  \renewcommand\kopR{#1}%
  {\sffamily\fontsize{13}{15}\selectfont\bfseries\color{hs}#1}\hfill
  {\sffamily\scriptsize\bfseries\color{white}\colorbox{hs}{\strut syllabus #2}}\par\nobreak\vskip 2pt
  {\itshape\small\color{grijs}#3}\par\nobreak\vskip 4pt\nobreak
  {\color{hs}\rule{\linewidth}{1.2pt}}\par\nobreak\vskip 2pt\nobreak}

\def\OpgNodig{0.28\textheight}
\newcommand\Opgave[5]{% nr, titel, bron, label, punten
  \par\Needspace{\OpgNodig}\vskip 15pt
  \phantomsection\label{#4}%
  {\sffamily\fontsize{7.5}{9}\selectfont\bfseries\color{white}\colorbox{hs}{\strut #1}}\enspace
  {\sffamily\bfseries\fontsize{11.5}{13}\selectfont #2}\hfill
  {\sffamily\scriptsize\color{grijs}#3\enspace\textbullet\enspace #5 punten}\par\nobreak\vskip 3pt\nobreak

  \begin{tikzpicture}[remember picture,overlay]
    \pgfmathsetmacro\tabboven{24+(\Tab-1)*25}
    \ifodd\value{page}
      \fill[hs] ($(current page.north east)+(-4.2mm,-\tabboven mm)$) rectangle ++(6mm,-21mm);
      \node[rotate=-90,text=white,font=\sffamily\bfseries\tiny] at ($(current page.north east)+(-2.1mm,-\tabboven mm-10.5mm)$) {\Tabtekst};
    \else
      \fill[hs] ($(current page.north west)+(4.2mm,-\tabboven mm)$) rectangle ++(-6mm,-21mm);
      \node[rotate=90,text=white,font=\sffamily\bfseries\tiny] at ($(current page.north west)+(2.1mm,-\tabboven mm-10.5mm)$) {\Tabtekst};
    \fi
  \end{tikzpicture}%
  \fi}
